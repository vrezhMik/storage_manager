// HTTP-сервис Eportal, шаблон /RetailPlan, метод GET.
// Параметры: Date=ДД.ММ.ГГГГ, Store=наименование склада (магазина).
//   Store передает терминал: это магазин, указанный у пользователя в админке.
//   Без Store - все склады, у которых есть план на этот месяц.
// Ответ: {"Date": "ГГГГ-ММ-ДД", "Stores": [{"Магазин", "Продажи", "План"}], "ErrorMessage": "200"}
//   Продажи - выручка склада с 1-го числа месяца по Date включительно
//             (РегистрНакопления.ВыручкаИСебестоимостьПродаж),
//   План    - план склада на месяц (РегистрСведений.Планы, Дата в том же месяце).

Функция RetailPlan(Запрос)

	ДатаСтрока = "";
	ИмяМагазина = "";
	Для Каждого ЗначениеСтруктуры Из Запрос.ПараметрыЗапроса Цикл
		Если ЗначениеСтруктуры.Ключ = "Date" Тогда
			ДатаСтрока = СокрЛП(Строка(ЗначениеСтруктуры.Значение));
		КонецЕсли;
		Если ЗначениеСтруктуры.Ключ = "Store" Тогда
			ИмяМагазина = СокрЛП(Строка(ЗначениеСтруктуры.Значение));
		КонецЕсли;
	КонецЦикла;

	Если ДатаСтрока = "" Тогда
		ДатаОтчета = ТекущаяДатаСеанса();
	Иначе
		ДатаОтчета = Дата(Число(Сред(ДатаСтрока, 7, 4)), Число(Сред(ДатаСтрока, 4, 2)), Число(Лев(ДатаСтрока, 2)));
	КонецЕсли;

	// Склад по наименованию (точное совпадение).
	Склад = Справочники.Склады.ПустаяСсылка();
	Если ИмяМагазина <> "" Тогда
		Склад = Справочники.Склады.НайтиПоНаименованию(ИмяМагазина, Истина);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			СтруктураJSON = Новый Структура;
			СтруктураJSON.Вставить("Date", Формат(ДатаОтчета, "ДФ=yyyy-MM-dd"));
			СтруктураJSON.Вставить("Stores", Новый Массив);
			СтруктураJSON.Вставить("ErrorMessage", "Store not found");
			Возврат ОтветJSON(СтруктураJSON);
		КонецЕсли;
	КонецЕсли;

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	Планы.Склад КАК Склад,
	|	СУММА(Планы.План) КАК План
	|ПОМЕСТИТЬ ВТПланы
	|ИЗ
	|	РегистрСведений.Планы КАК Планы
	|ГДЕ
	|	Планы.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
	|	И (&ВсеСклады
	|			ИЛИ Планы.Склад = &Склад)
	|
	|СГРУППИРОВАТЬ ПО
	|	Планы.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Продажи.АналитикаУчетаНоменклатуры.Склад КАК Склад,
	|	СУММА(Продажи.СуммаВыручкиОборот) КАК Продажи
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&НачалоМесяца, &КонецДня, , ) КАК Продажи
	|ГДЕ
	|	(&ВсеСклады
	|				И Продажи.АналитикаУчетаНоменклатуры.Склад В
	|					(ВЫБРАТЬ
	|						ВТПланы.Склад
	|					ИЗ
	|						ВТПланы КАК ВТПланы)
	|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Склад = &Склад)
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.АналитикаУчетаНоменклатуры.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТПродажи.Склад, ВТПланы.Склад) КАК Склад,
	|	ЕСТЬNULL(ВТПродажи.Продажи, 0) КАК Продажи,
	|	ЕСТЬNULL(ВТПланы.План, 0) КАК План
	|ИЗ
	|	ВТПродажи КАК ВТПродажи
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТПланы КАК ВТПланы
	|		ПО ВТПродажи.Склад = ВТПланы.Склад";

	ЗапросДанных.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаОтчета));
	ЗапросДанных.УстановитьПараметр("КонецМесяца", КонецМесяца(ДатаОтчета));
	ЗапросДанных.УстановитьПараметр("КонецДня", КонецДня(ДатаОтчета));
	ЗапросДанных.УстановитьПараметр("ВсеСклады", Не ЗначениеЗаполнено(Склад));
	ЗапросДанных.УстановитьПараметр("Склад", Склад);

	МассивОтвета = Новый Массив;
	Выборка = ЗапросДанных.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("Магазин", Строка(Выборка.Склад));
		СтруктураОтвета.Вставить("Продажи", Выборка.Продажи);
		СтруктураОтвета.Вставить("План", Выборка.План);
		МассивОтвета.Добавить(СтруктураОтвета);
	КонецЦикла;

	// Магазин найден, но в этом месяце еще нет ни продаж, ни плана: показываем нули.
	Если МассивОтвета.Количество() = 0 И ЗначениеЗаполнено(Склад) Тогда
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("Магазин", Строка(Склад));
		СтруктураОтвета.Вставить("Продажи", 0);
		СтруктураОтвета.Вставить("План", 0);
		МассивОтвета.Добавить(СтруктураОтвета);
	КонецЕсли;

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("Date", Формат(ДатаОтчета, "ДФ=yyyy-MM-dd"));
	СтруктураJSON.Вставить("Stores", МассивОтвета);
	СтруктураJSON.Вставить("ErrorMessage", "200");

	Возврат ОтветJSON(СтруктураJSON);

КонецФункции

Функция ОтветJSON(СтруктураJSON)

	ЗаписьJSON 			= Новый ЗаписьJSON;
	ПараметрыJSON 		= Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " ", Истина);
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураJSON);
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Ответ;

КонецФункции

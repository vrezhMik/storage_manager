// HTTP-сервис Eportal, шаблон /RetailPlan, метод GET.
// Параметры: Date=ДД.ММ.ГГГГ, Store=наименование склада (магазина).
//   Store передает терминал: это магазин, указанный у пользователя в админке.
//   Без Store - все склады, у которых есть план на этот месяц.
// Ответ: {"Date": "ГГГГ-ММ-ДД", "Stores": [{"Магазин", "Продажи", "План"}], "ErrorMessage": "200"}
//   Продажи - выручка склада с 1-го числа месяца по Date включительно
//             (РегистрНакопления.ВыручкаИСебестоимостьПродаж),
//   План    - план склада на месяц (РегистрСведений.Планы, Дата в том же месяце).

Функция RetailPlan(Запрос)

	ДатаСтрока = "";
	ИмяМагазина = "";
	Для Каждого ЗначениеСтруктуры Из Запрос.ПараметрыЗапроса Цикл
		Если ЗначениеСтруктуры.Ключ = "Date" Тогда
			ДатаСтрока = СокрЛП(Строка(ЗначениеСтруктуры.Значение));
		КонецЕсли;
		Если ЗначениеСтруктуры.Ключ = "Store" Тогда
			ИмяМагазина = СокрЛП(Строка(ЗначениеСтруктуры.Значение));
		КонецЕсли;
	КонецЦикла;

	Если ДатаСтрока = "" Тогда
		ДатаОтчета = ТекущаяДатаСеанса();
	Иначе
		ДатаОтчета = Дата(Число(Сред(ДатаСтрока, 7, 4)), Число(Сред(ДатаСтрока, 4, 2)), Число(Лев(ДатаСтрока, 2)));
	КонецЕсли;

	// Склад по наименованию (точное совпадение).
	Склад = Справочники.Склады.ПустаяСсылка();
	Если ИмяМагазина <> "" Тогда
		Склад = Справочники.Склады.НайтиПоНаименованию(ИмяМагазина, Истина);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			СтруктураJSON = Новый Структура;
			СтруктураJSON.Вставить("Date", Формат(ДатаОтчета, "ДФ=yyyy-MM-dd"));
			СтруктураJSON.Вставить("Stores", Новый Массив);
			СтруктураJSON.Вставить("ErrorMessage", "Store not found");
			Возврат ОтветJSON(СтруктураJSON);
		КонецЕсли;
	КонецЕсли;

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	Планы.Склад КАК Склад,
	|	СУММА(Планы.План) КАК План
	|ПОМЕСТИТЬ ВТПланы
	|ИЗ
	|	РегистрСведений.Планы КАК Планы
	|ГДЕ
	|	Планы.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
	|	И (&ВсеСклады
	|			ИЛИ Планы.Склад = &Склад)
	|
	|СГРУППИРОВАТЬ ПО
	|	Планы.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Продажи.АналитикаУчетаНоменклатуры.Склад КАК Склад,
	|	СУММА(Продажи.СуммаВыручкиОборот) КАК Продажи
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&НачалоМесяца, &КонецДня, , ) КАК Продажи
	|ГДЕ
	|	(&ВсеСклады
	|				И Продажи.АналитикаУчетаНоменклатуры.Склад В
	|					(ВЫБРАТЬ
	|						ВТПланы.Склад
	|					ИЗ
	|						ВТПланы КАК ВТПланы)
	|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Склад = &Склад)
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.АналитикаУчетаНоменклатуры.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТПродажи.Склад, ВТПланы.Склад) КАК Склад,
	|	ЕСТЬNULL(ВТПродажи.Продажи, 0) КАК Продажи,
	|	ЕСТЬNULL(ВТПланы.План, 0) КАК План
	|ИЗ
	|	ВТПродажи КАК ВТПродажи
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТПланы КАК ВТПланы
	|		ПО ВТПродажи.Склад = ВТПланы.Склад";

	ЗапросДанных.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаОтчета));
	ЗапросДанных.УстановитьПараметр("КонецМесяца", КонецМесяца(ДатаОтчета));
	ЗапросДанных.УстановитьПараметр("КонецДня", КонецДня(ДатаОтчета));
	ЗапросДанных.УстановитьПараметр("ВсеСклады", Не ЗначениеЗаполнено(Склад));
	ЗапросДанных.УстановитьПараметр("Склад", Склад);

	МассивОтвета = Новый Массив;
	Выборка = ЗапросДанных.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("Магазин", Строка(Выборка.Склад));
		СтруктураОтвета.Вставить("Продажи", Выборка.Продажи);
		СтруктураОтвета.Вставить("План", Выборка.План);
		МассивОтвета.Добавить(СтруктураОтвета);
	КонецЦикла;

	// Магазин найден, но в этом месяце еще нет ни продаж, ни плана: показываем нули.
	Если МассивОтвета.Количество() = 0 И ЗначениеЗаполнено(Склад) Тогда
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("Магазин", Строка(Склад));
		СтруктураОтвета.Вставить("Продажи", 0);
		СтруктураОтвета.Вставить("План", 0);
		МассивОтвета.Добавить(СтруктураОтвета);
	КонецЕсли;

	// Планы по группам брендов (если справочник и регистр уже созданы).
	МассивБрендов = Новый Массив;
	ДублиБрендов = Новый Массив;
	Если Метаданные.РегистрыСведений.Найти("ПланыПоБрендам") <> Неопределено
		И Метаданные.Справочники.Найти("ГруппыБрендовПлана") <> Неопределено Тогда
		ЗаполнитьПланыПоБрендам(ДатаОтчета, Склад, МассивБрендов, ДублиБрендов);
	КонецЕсли;

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("Date", Формат(ДатаОтчета, "ДФ=yyyy-MM-dd"));
	СтруктураJSON.Вставить("Stores", МассивОтвета);
	СтруктураJSON.Вставить("Brands", МассивБрендов);
	Если ДублиБрендов.Количество() > 0 Тогда
		СтруктураJSON.Вставить("BrandWarning", ДублиБрендов);
	КонецЕсли;
	СтруктураJSON.Вставить("ErrorMessage", "200");

	Возврат ОтветJSON(СтруктураJSON);

КонецФункции

// Brands: [{"Магазин", "Группа", "Бренды": [{"Бренд", "Продажи"}], "Продажи", "План"}]
//   Бренды  - бренды группы и продажи каждого из них в этом магазине,
//   План    - РегистрСведений.ПланыПоБрендам (Склад, Дата, ГруппаБрендов -> План),
//   Продажи - выручка склада с 1-го числа по товарам, у которых
//             Номенклатура.МаркаБренд входит в группу (Справочник.ГруппыБрендовПлана, ТЧ Бренды).
// ДублиБрендов - бренды, которые попали в несколько групп (их продажи посчитаются дважды).
Процедура ЗаполнитьПланыПоБрендам(ДатаОтчета, Склад, МассивБрендов, ДублиБрендов)

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	Планы.Склад КАК Склад,
	|	Планы.ГруппаБрендов КАК ГруппаБрендов,
	|	СУММА(Планы.План) КАК План
	|ПОМЕСТИТЬ ВТПланы
	|ИЗ
	|	РегистрСведений.ПланыПоБрендам КАК Планы
	|ГДЕ
	|	Планы.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
	|	И (&ВсеСклады
	|			ИЛИ Планы.Склад = &Склад)
	|
	|СГРУППИРОВАТЬ ПО
	|	Планы.Склад,
	|	Планы.ГруппаБрендов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Состав.Ссылка КАК ГруппаБрендов,
	|	Состав.МаркаБренд КАК МаркаБренд
	|ПОМЕСТИТЬ ВТСостав
	|ИЗ
	|	Справочник.ГруппыБрендовПлана.Бренды КАК Состав
	|ГДЕ
	|	Состав.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТПланы.ГруппаБрендов
	|			ИЗ
	|				ВТПланы КАК ВТПланы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Продажи.АналитикаУчетаНоменклатуры.Склад КАК Склад,
	|	ВТСостав.ГруппаБрендов КАК ГруппаБрендов,
	|	ВТСостав.МаркаБренд КАК МаркаБренд,
	|	СУММА(Продажи.СуммаВыручкиОборот) КАК Продажи
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&НачалоМесяца, &КонецДня, , ) КАК Продажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСостав КАК ВТСостав
	|		ПО Продажи.АналитикаУчетаНоменклатуры.Номенклатура.МаркаБренд = ВТСостав.МаркаБренд
	|ГДЕ
	|	(&ВсеСклады
	|				И Продажи.АналитикаУчетаНоменклатуры.Склад В
	|					(ВЫБРАТЬ
	|						ВТПланы.Склад
	|					ИЗ
	|						ВТПланы КАК ВТПланы)
	|			ИЛИ Продажи.АналитикаУчетаНоменклатуры.Склад = &Склад)
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.АналитикаУчетаНоменклатуры.Склад,
	|	ВТСостав.ГруппаБрендов,
	|	ВТСостав.МаркаБренд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПланы.Склад КАК Склад,
	|	ВТПланы.ГруппаБрендов КАК ГруппаБрендов,
	|	ВТПланы.План КАК План,
	|	ЕСТЬNULL(ПродажиГрупп.Продажи, 0) КАК Продажи
	|ИЗ
	|	ВТПланы КАК ВТПланы
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТПродажи.Склад КАК Склад,
	|			ВТПродажи.ГруппаБрендов КАК ГруппаБрендов,
	|			СУММА(ВТПродажи.Продажи) КАК Продажи
	|		ИЗ
	|			ВТПродажи КАК ВТПродажи
	|		СГРУППИРОВАТЬ ПО
	|			ВТПродажи.Склад,
	|			ВТПродажи.ГруппаБрендов) КАК ПродажиГрупп
	|		ПО ВТПланы.Склад = ПродажиГрупп.Склад
	|			И ВТПланы.ГруппаБрендов = ПродажиГрупп.ГруппаБрендов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПланы.Склад КАК Склад,
	|	ВТСостав.ГруппаБрендов КАК ГруппаБрендов,
	|	ВТСостав.МаркаБренд КАК МаркаБренд,
	|	ЕСТЬNULL(ВТПродажи.Продажи, 0) КАК Продажи
	|ИЗ
	|	ВТПланы КАК ВТПланы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСостав КАК ВТСостав
	|		ПО ВТПланы.ГруппаБрендов = ВТСостав.ГруппаБрендов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПродажи КАК ВТПродажи
	|		ПО ВТПланы.Склад = ВТПродажи.Склад
	|			И ВТСостав.ГруппаБрендов = ВТПродажи.ГруппаБрендов
	|			И ВТСостав.МаркаБренд = ВТПродажи.МаркаБренд
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТСостав.МаркаБренд.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСостав.МаркаБренд КАК МаркаБренд
	|ИЗ
	|	ВТСостав КАК ВТСостав
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСостав.МаркаБренд
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТСостав.ГруппаБрендов) > 1";

	ЗапросДанных.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаОтчета));
	ЗапросДанных.УстановитьПараметр("КонецМесяца", КонецМесяца(ДатаОтчета));
	ЗапросДанных.УстановитьПараметр("КонецДня", КонецДня(ДатаОтчета));
	ЗапросДанных.УстановитьПараметр("ВсеСклады", Не ЗначениеЗаполнено(Склад));
	ЗапросДанных.УстановитьПараметр("Склад", Склад);
	Результаты = ЗапросДанных.ВыполнитьПакет();

	// "Склад|Группа" -> массив {Бренд, Продажи}: продажи каждого бренда группы в этом магазине.
	СоставГрупп = Новый Соответствие;
	Выборка = Результаты[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = КлючСкладГруппа(Выборка.Склад, Выборка.ГруппаБрендов);
		Бренды = СоставГрупп.Получить(Ключ);
		Если Бренды = Неопределено Тогда
			Бренды = Новый Массив;
			СоставГрупп.Вставить(Ключ, Бренды);
		КонецЕсли;
		Бренд = Новый Структура;
		Бренд.Вставить("Бренд", Строка(Выборка.МаркаБренд));
		Бренд.Вставить("Продажи", Выборка.Продажи);
		Бренды.Добавить(Бренд);
	КонецЦикла;

	Выборка = Результаты[3].Выбрать();
	Пока Выборка.Следующий() Цикл
		Бренды = СоставГрупп.Получить(КлючСкладГруппа(Выборка.Склад, Выборка.ГруппаБрендов));
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("Магазин", Строка(Выборка.Склад));
		СтруктураОтвета.Вставить("Группа", Строка(Выборка.ГруппаБрендов));
		СтруктураОтвета.Вставить("Бренды", ?(Бренды = Неопределено, Новый Массив, Бренды));
		СтруктураОтвета.Вставить("Продажи", Выборка.Продажи);
		СтруктураОтвета.Вставить("План", Выборка.План);
		МассивБрендов.Добавить(СтруктураОтвета);
	КонецЦикла;

	Выборка = Результаты[5].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДублиБрендов.Добавить(Строка(Выборка.МаркаБренд));
	КонецЦикла;

КонецПроцедуры

Функция КлючСкладГруппа(Склад, ГруппаБрендов)

	Возврат Строка(Склад.УникальныйИдентификатор()) + "|" + Строка(ГруппаБрендов.УникальныйИдентификатор());

КонецФункции

Функция ОтветJSON(СтруктураJSON)

	ЗаписьJSON 			= Новый ЗаписьJSON;
	ПараметрыJSON 		= Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " ", Истина);
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураJSON);
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "application/json;  charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Ответ;

КонецФункции

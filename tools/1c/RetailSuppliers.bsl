// HTTP-сервис Eportal, шаблон /RetailSuppliers, метод GET.
// Вставлять в тот же модуль, что и RetailPlan: использует его функцию ОтветJSON.
// Параметры: Date=ДД.ММ.ГГГГ, Days=число дней назад (обычно 90),
//            Store=наименование склада (магазина; без Store - все склады).
// Берет проведенные документы "Поступление товаров и услуг" за Days дней по Date включительно.
// Ответ:
//   {"Date": "ГГГГ-ММ-ДД", "Days": 90,
//    "Deliveries": [{"Поставщик", "Дата": "ГГГГ-ММ-ДД", "Сумма", "Документ"}],
//    "Items": [{"Поставщик", "Номенклатура", "Количество", "Сумма"}],
//    "ErrorMessage": "200"}
// Ритм поставщика, опоздание и топ товаров считает терминал.

Функция RetailSuppliers(Запрос)

	ДатаСтрока = "";
	ИмяМагазина = "";
	Дней = 90;
	Для Каждого ЗначениеСтруктуры Из Запрос.ПараметрыЗапроса Цикл
		Если ЗначениеСтруктуры.Ключ = "Date" Тогда
			ДатаСтрока = СокрЛП(Строка(ЗначениеСтруктуры.Значение));
		КонецЕсли;
		Если ЗначениеСтруктуры.Ключ = "Store" Тогда
			ИмяМагазина = СокрЛП(Строка(ЗначениеСтруктуры.Значение));
		КонецЕсли;
		Если ЗначениеСтруктуры.Ключ = "Days" Тогда
			Дней = Число(ЗначениеСтруктуры.Значение);
		КонецЕсли;
	КонецЦикла;

	Если ДатаСтрока = "" Тогда
		ДатаОтчета = ТекущаяДатаСеанса();
	Иначе
		ДатаОтчета = Дата(Число(Сред(ДатаСтрока, 7, 4)), Число(Сред(ДатаСтрока, 4, 2)), Число(Лев(ДатаСтрока, 2)));
	КонецЕсли;
	НачалоПериода = НачалоДня(ДатаОтчета) - (Дней - 1) * 86400;
	КонецПериода = КонецДня(ДатаОтчета);

	Склад = Справочники.Склады.ПустаяСсылка();
	Если ИмяМагазина <> "" Тогда
		Склад = Справочники.Склады.НайтиПоНаименованию(ИмяМагазина, Истина);
		Если Не ЗначениеЗаполнено(Склад) Тогда
			СтруктураJSON = Новый Структура;
			СтруктураJSON.Вставить("Date", Формат(ДатаОтчета, "ДФ=yyyy-MM-dd"));
			СтруктураJSON.Вставить("Days", Дней);
			СтруктураJSON.Вставить("Deliveries", Новый Массив);
			СтруктураJSON.Вставить("Items", Новый Массив);
			СтруктураJSON.Вставить("ErrorMessage", "Store not found");
			Возврат ОтветJSON(СтруктураJSON);
		КонецЕсли;
	КонецЕсли;

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
	"ВЫБРАТЬ
	|	Поступление.Ссылка КАК Ссылка,
	|	Поступление.Дата КАК Дата,
	|	Поступление.Номер КАК Номер,
	|	Поступление.Партнер КАК Поставщик,
	|	Поступление.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Поступление
	|ГДЕ
	|	Поступление.Проведен
	|	И Поступление.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И (&ВсеСклады
	|			ИЛИ Поступление.Склад = &Склад)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка.Партнер КАК Поставщик,
	|	Товары.Номенклатура КАК Номенклатура,
	|	СУММА(Товары.Количество) КАК Количество,
	|	СУММА(Товары.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка.Проведен
	|	И Товары.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И (&ВсеСклады
	|			ИЛИ Товары.Ссылка.Склад = &Склад)
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ссылка.Партнер,
	|	Товары.Номенклатура";

	ЗапросДанных.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросДанных.УстановитьПараметр("КонецПериода", КонецПериода);
	ЗапросДанных.УстановитьПараметр("ВсеСклады", Не ЗначениеЗаполнено(Склад));
	ЗапросДанных.УстановитьПараметр("Склад", Склад);
	Результаты = ЗапросДанных.ВыполнитьПакет();

	МассивПоставок = Новый Массив;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Поставка = Новый Структура;
		Поставка.Вставить("Поставщик", Строка(Выборка.Поставщик));
		Поставка.Вставить("Дата", Формат(Выборка.Дата, "ДФ=yyyy-MM-dd"));
		Поставка.Вставить("Сумма", Выборка.Сумма);
		Поставка.Вставить("Документ", СокрЛП(Выборка.Номер));
		МассивПоставок.Добавить(Поставка);
	КонецЦикла;

	МассивТоваров = Новый Массив;
	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Товар = Новый Структура;
		Товар.Вставить("Поставщик", Строка(Выборка.Поставщик));
		Товар.Вставить("Номенклатура", Строка(Выборка.Номенклатура));
		Товар.Вставить("Количество", Выборка.Количество);
		Товар.Вставить("Сумма", Выборка.Сумма);
		МассивТоваров.Добавить(Товар);
	КонецЦикла;

	СтруктураJSON = Новый Структура;
	СтруктураJSON.Вставить("Date", Формат(ДатаОтчета, "ДФ=yyyy-MM-dd"));
	СтруктураJSON.Вставить("Days", Дней);
	СтруктураJSON.Вставить("Deliveries", МассивПоставок);
	СтруктураJSON.Вставить("Items", МассивТоваров);
	СтруктураJSON.Вставить("ErrorMessage", "200");

	Возврат ОтветJSON(СтруктураJSON);

КонецФункции

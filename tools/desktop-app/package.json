{
  "name": "flexit-terminal",
  "productName": "Flexit",
  "version": "1.0.0",
  "description": "Flexit terminal for Windows: requests that need this computer's own IP (tax service, 1C) are made from this computer.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "am.flexit.terminal",
    "productName": "Flexit",
    "files": ["main.js", "preload.js", "icon.png"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "Flexit" },
    "directories": { "output": "dist" }
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
